# Reference only - Spring Boot reads OS environment variables directly, it
# does not load a .env file. Set these as real environment variables (e.g.
# Windows: [Environment]::SetEnvironmentVariable('DB_PASSWORD', '...', 'User'),
# then restart your terminal/IDE) before running the backend.

# No default in application.properties - required, startup fails without it.
DB_PASSWORD=

# These two already have local-dev defaults in application.properties and
# only need overriding for a non-standard local setup or another environment.
DB_URL=jdbc:postgresql://localhost:5432/immaculate_grid
DB_USERNAME=grid

# Comma-separated. Defaults to the local Vite dev origin; add the real
# frontend domain here once deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated allowlist of emails allowed to use /api/admin/** (puzzle
# curation + tracking). No default in application.properties - empty means
# nobody, including you, can access admin endpoints. Must be set explicitly
# on the real production deployment, not just local dev.
ADMIN_EMAILS=
